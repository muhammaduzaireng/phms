{
  "name": "pharmacy-management-system",
  "version": "1.0.0",
  "description": "Pharmacy Management System with React Frontend and Node.js Backend",
  "main": "backend/server.js",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "dev": "concurrently \"npm run backend-dev\" \"npm run frontend\"",
    "backend": "node backend/server.js",
    "backend-dev": "nodemon backend/server.js",
    "frontend": "cd frontend && npm start",
    "install-frontend": "cd frontend && npm install",
    "install-all": "npm install && cd frontend && npm install",
    "migrate": "node backend/scripts/migrateDataToDB.js",
    "test-db": "node backend/scripts/testConnection.js",
    "create-admin": "node backend/scripts/createDefaultAdmin.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "react-window": "^2.2.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.1"
  }
}
